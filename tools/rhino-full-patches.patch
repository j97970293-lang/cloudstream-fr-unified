diff --git a/rhino/src/main/java/org/mozilla/javascript/J8Compat.java b/rhino/src/main/java/org/mozilla/javascript/J8Compat.java
new file mode 100644
index 0000000..246aab2
--- /dev/null
+++ b/rhino/src/main/java/org/mozilla/javascript/J8Compat.java
@@ -0,0 +1,95 @@
+package org.mozilla.javascript;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.Set;
+
+/**
+ * Équivalents Java 8 des API Java 9+ utilisées par Rhino 1.9.1
+ * (indisponibles sur Android avant API 30).
+ */
+public final class J8Compat {
+    private J8Compat() {}
+
+    public static <K, V> Map.Entry<K, V> entry(K k, V v) {
+        return new java.util.AbstractMap.SimpleImmutableEntry<>(k, v);
+    }
+
+    @SafeVarargs
+    public static <K, V> Map<K, V> mapOfEntries(Map.Entry<? extends K, ? extends V>... entries) {
+        Map<K, V> m = new LinkedHashMap<>();
+        for (Map.Entry<? extends K, ? extends V> e : entries) m.put(e.getKey(), e.getValue());
+        return Collections.unmodifiableMap(m);
+    }
+
+    public static <K, V> Map<K, V> mapOf() {
+        return Collections.emptyMap();
+    }
+
+    public static <K, V> Map<K, V> mapOf(Object... kv) {
+        Map<K, V> m = new LinkedHashMap<>();
+        for (int i = 0; i + 1 < kv.length; i += 2) {
+            @SuppressWarnings("unchecked")
+            K k = (K) kv[i];
+            @SuppressWarnings("unchecked")
+            V v = (V) kv[i + 1];
+            m.put(k, v);
+        }
+        return Collections.unmodifiableMap(m);
+    }
+
+    public static <E> List<E> listOf() {
+        return Collections.emptyList();
+    }
+
+    public static <E> Set<E> setOf() {
+        return Collections.emptySet();
+    }
+
+    @SafeVarargs
+    public static <E> List<E> listOf(E... items) {
+        List<E> l = new java.util.ArrayList<>(items.length);
+        Collections.addAll(l, items);
+        return Collections.unmodifiableList(l);
+    }
+
+    @SafeVarargs
+    public static <E> Set<E> setOf(E... items) {
+        Set<E> s = new java.util.LinkedHashSet<>();
+        Collections.addAll(s, items);
+        return Collections.unmodifiableSet(s);
+    }
+
+    public static <K, V> Map<K, V> copyOf(Map<K, V> m) {
+        return Collections.unmodifiableMap(new LinkedHashMap<>(m));
+    }
+
+    public static <E> List<E> copyOf(List<E> l) {
+        return Collections.unmodifiableList(new java.util.ArrayList<>(l));
+    }
+
+    public static <E> Set<E> copyOf(Set<E> s) {
+        return Collections.unmodifiableSet(new java.util.LinkedHashSet<>(s));
+    }
+
+    public static byte[] readAllBytes(InputStream in) throws IOException {
+        java.io.ByteArrayOutputStream buf = new java.io.ByteArrayOutputStream();
+        byte[] chunk = new byte[8192];
+        int n;
+        while ((n = in.read(chunk)) != -1) buf.write(chunk, 0, n);
+        return buf.toByteArray();
+    }
+
+    public static <T> T requireNonNullElse(T obj, T def) {
+        return obj != null ? obj : Objects.requireNonNull(def);
+    }
+
+    public static <T> T requireNonNullElseGet(T obj, java.util.function.Supplier<T> sup) {
+        return obj != null ? obj : Objects.requireNonNull(sup.get());
+    }
+}
